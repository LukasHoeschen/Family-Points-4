    },
    "Deleting your family (%@) will erase all your data from our servers, including tasks, lists, family members, and their devices. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihre Familie löschen (%@), werden alle Ihre Daten von unseren Servern gelöscht, einschließlich Aufgaben, Listen, Familienmitglieder und deren Geräte. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "Deleting your user will remove all your user data (%@) stored on our servers. Your account cannot be reinstalled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihren Benutzer löschen, werden alle auf unseren Servern gespeicherten Benutzerdaten (%@) gelöscht. Ihr Konto kann nicht wiederhergestellt werden."
          }
        }
      }
    },
