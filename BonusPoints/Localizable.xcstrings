            "value" : "Bitte deine Eltern um Hilfe."
          }
        }
      }
    },
    "Please establish an internet connection" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte stelle eine Internetverbindung her"
          }
        }
      }
    },
    "Please note that your data is exported without encryption, and your family's secret encryption key is stored in plain text.\n**Please do not delete your device or logout in this App on this device!**" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte beachten Sie, dass Ihre Daten unverschlüsselt exportiert werden und der geheime Verschlüsselungscode Ihrer Familie im Klartext gespeichert wird.\n**Bitte löschen Sie Ihr Gerät nicht und melden Sie sich in dieser App auf diesem Gerät nicht ab!**"
          }
        }
      }
    },
