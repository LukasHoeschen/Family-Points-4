            "value" : "Mi"
          }
        }
      }
    },
    "When %@ completes tasks, they will appear here for your approval. You can then choose to either accept or deny them. This way, you can award points only when the task has truly been completed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn %@ Aufgaben erledigt, werden diese hier angezeigt. Du kannst sie dann akzeptieren oder ablehnen, je nachdem, ob diese Aufgabe wirklich erledigt wurde."
          }
        }
      }
    },
    "With the free version of Family Points, you enjoy the following features:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der kostenlosen Version von Family Points genießen Sie die folgenden Funktionen:"
